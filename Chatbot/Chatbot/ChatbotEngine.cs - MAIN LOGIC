using System;

namespace CyberAwarenessChatbotGUI.Chatbot
{
    public class ChatbotEngine
    {
        public delegate string ChatbotResponseDelegate(string userInput);
        public ChatbotResponseDelegate responseHandler;

        public MemoryManager memory = new MemoryManager();
        public ResponseManager responses = new ResponseManager();
        public SentimentDetector sentiment = new SentimentDetector();

        public ChatbotEngine()
        {
            responseHandler = ProcessInput; // Delegate assignment - CRITICAL FOR MARKS
        }

        public string ProcessInput(string input)
        {
            if (string.IsNullOrWhiteSpace(input))
                return "I'm not sure I understand. Can you try rephrasing?";

            string lower = input.ToLower();

            // Q5 Memory - Name
            if (string.IsNullOrEmpty(memory.UserName) && (lower.Contains("my name is") || lower.Contains("i am") || lower.Length < 20 &&!lower.Contains(" ")))
            {
                if (!responses.ContainsKeyword(lower, out _) &&!lower.Contains("interested") &&!lower.Contains("worried"))
                {
                    string name = input.Replace("my name is", "", StringComparison.OrdinalIgnoreCase)
                                      .Replace("i am", "", StringComparison.OrdinalIgnoreCase).Trim();
                    if (name.Length > 1 && name.Length < 30)
                    {
                        memory.UserName = name;
                        return $"Nice to meet you, {memory.UserName}! What cybersecurity topic are you interested in? (password, scam, privacy, phishing)";
                    }
                }
            }

            if (lower.Contains("my name is"))
            {
                string name = input.Split("my name is")[1].Trim();
                memory.UserName = name;
                return $"Got it! I'll remember your name is {memory.UserName}.";
            }

            // Q5 Memory - Favourite topic
            if (lower.Contains("interested in") || lower.Contains("favourite is") || lower.Contains("favorite is") || lower.Contains("i like"))
            {
                foreach (var key in responses.keywordResponses.Keys)
                {
                    if (lower.Contains(key))
                    {
                        memory.SetFavourite(key);
                        return $"Great! I'll remember you're interested in {key}. I'll tailor my tips for you.\nAs someone interested in {key}, you should: {responses.GetRandomResponse(key)}";
                    }
                }
            }

            // Q4 Conversation Flow
            if (lower.Contains("another") || lower.Contains("more") || lower.Contains("tell me more") || lower.Contains("explain more") || lower.Contains("give me another tip"))
            {
                if (!string.IsNullOrEmpty(memory.LastTopic))
                {
                    string personalized =!string.IsNullOrEmpty(memory.FavouriteTopic) && memory.FavouriteTopic == memory.LastTopic
                       ? $"As someone interested in {memory.FavouriteTopic}, here's another tip: "
                        : "";
                    return personalized + responses.GetRandomResponse(memory.LastTopic);
                }
                return "Sure! Which topic? Try: password, scam, privacy, phishing.";
            }

            // Q6 Sentiment Detection + MUST AUTO-GIVE TIP
            string sentimentType = sentiment.Detect(lower);
            string empathetic = sentiment.GetEmpatheticResponse(sentimentType);

            // Q2 Keyword Recognition
            if (responses.ContainsKeyword(lower, out string foundKeyword))
            {
                memory.LastTopic = foundKeyword;
                string tip = responses.GetRandomResponse(foundKeyword);

                // Q5 Personalization
                string personalPrefix = "";
                if (!string.IsNullOrEmpty(memory.FavouriteTopic) && memory.FavouriteTopic == foundKeyword)
                {
                    personalPrefix = $"As someone interested in {foundKeyword}, you might want to know: ";
                }
                else if (!string.IsNullOrEmpty(memory.UserName))
                {
                    personalPrefix = $"{memory.UserName}, ";
                }

                // If sentiment detected, combine empathetic + tip (Q6 critical requirement)
                if (sentimentType!= "neutral")
                {
                    return empathetic + personalPrefix + tip;
                }

                return personalPrefix + tip;
            }

            // If only sentiment, still give general tip (to satisfy Q6 auto-tip rule)
            if (sentimentType!= "neutral")
            {
                string generalTip = responses.GetRandomResponse("scam");
                return empathetic + $"Let me share a general safety tip: {generalTip}";
            }

            // Q7 Error handling
            return "I'm not sure I understand. Can you try rephrasing? I can help with: password, scam, privacy, phishing, malware. Or say 'I'm interested in privacy' so I remember!";
        }
    }
}
