import numpy as np
from scipy.io import wavfile
sr = 44100
def tone(f,d):
    t=np.linspace(0,d,int(sr*d),False)
    return (0.6*32767*np.sin(2*np.pi*f*t)).astype(np.int16)
def silence(d):
    return np.zeros(int(sr*d), dtype=np.int16)
melody = np.concatenate([tone(523.25,0.35), silence(0.06), tone(659.25,0.35), silence(0.06), tone(783.99,0.35), silence(0.12), tone(1046.5,1.0)])
wavfile.write('greeting.wav', sr, melody)
