private void StartConversation()
{
    while (true)
    {
        Console.ForegroundColor = ConsoleColor.Yellow;
        Console.Write("\nYou: ");
        Console.ResetColor();

        string userInput = Console.ReadLine();

        if (string.IsNullOrWhiteSpace(userInput))
        {
            Console.ForegroundColor = ConsoleColor.Red;
            Console.WriteLine("Bot: Please type something so I can help you.");
            Console.ResetColor();
            continue;
        }

        string input = userInput.ToLower().Trim();

        if (input == "exit" || input == "quit")
        {
            Console.ForegroundColor = ConsoleColor.Green;
            Console.WriteLine($"Bot: Goodbye, {UserName}! Stay safe online.");
            Console.ResetColor();
            break;
        }

        if (input.Contains("how are you"))
        {
            Console.WriteLine("Bot: I'm doing well, thanks for asking!");
            Console.WriteLine("Bot: I'm ready to help you with cybersecurity.");
        }
        else if (input.Contains("purpose"))
        {
            Console.WriteLine("Bot: My purpose is to teach users about basic cybersecurity.");
        }
        else if (input.Contains("what can") || input.Contains("help"))
        {
            Console.WriteLine("Bot: You can ask me about passwords, phishing or safe browsing.");
        }
        else if (input.Contains("password"))
        {
            ShowPasswordAdvice();
        }
        else if (input.Contains("phishing"))
        {
            ShowPhishingAdvice();
        }
        else if (input.Contains("browse") || input.Contains("internet"))
        {
            ShowBrowsingAdvice();
        }
        else
        {
            Console.WriteLine("Bot: I'm not sure about that.");
            Console.WriteLine("Bot: Try asking me about passwords, phishing or safe browsing.");
        }
    }
}
private void ShowPasswordAdvice()
{
    Console.ForegroundColor = ConsoleColor.Cyan;

    Console.WriteLine("\nBot: Password safety is very important.");
    Console.WriteLine("Bot: Use a strong and unique password for each account.");
    Console.WriteLine("Bot: Avoid using information such as your name or birthday.");
    Console.WriteLine("Bot: Never share your passwords with other people.");

    Console.ResetColor();
}

private void ShowPhishingAdvice()
{
    Console.ForegroundColor = ConsoleColor.Cyan;

    Console.WriteLine("\nBot: Phishing is a common cybersecurity threat.");
    Console.WriteLine("Bot: It happens when someone tries to trick you into giving");
    Console.WriteLine("Bot: away personal information or clicking a harmful link.");
    Console.WriteLine("Bot: Be careful with unexpected emails, messages and links.");

    Console.ResetColor();
}

private void ShowBrowsingAdvice()
{
    Console.ForegroundColor = ConsoleColor.Cyan;

    Console.WriteLine("\nBot: For safer browsing, avoid suspicious websites.");
    Console.WriteLine("Bot: Check website addresses before entering information.");
    Console.WriteLine("Bot: Keep your browser and computer updated.");
    Console.WriteLine("Bot: Do not download files from websites you do not trust.");

    Console.ResetColor();
}
ShowPasswordAdvice();
